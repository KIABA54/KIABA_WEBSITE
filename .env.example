# ==========================================
# CONFIGURATION KIABA RENCONTRE
# ==========================================

# URL de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE (Base de données, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# GENIUSPAY (Agrégateur de paiement Mobile Money & Cartes)
# Obtenez vos clés sur https://geniuspay.ci/dashboard/settings/api
GENIUSPAY_API_KEY=pk_sandbox_votre_cle_publique
GENIUSPAY_API_SECRET=sk_sandbox_votre_cle_secrete
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_votre_secret_webhook
GENIUSPAY_ENVIRONMENT=sandbox # ou 'live'

# EMAIL TRANSACTIONNEL (Resend ou SMTP)
RESEND_API_KEY=re_votre_cle_resend
EMAIL_FROM=contact@kiabarencontre.com
