# ==========================================
# CONFIGURATION KIABA RENCONTRE
# ==========================================

# URL de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SUPABASE (Base de données, Auth & Storage)
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# MODE LANCEMENT : "true" rend toute publication/boost/renouvellement
# gratuit, sans passer par GeniusPay (utile le temps de peupler un site tout
# juste ouvert). Repassez à "false" pour réactiver les paiements réels.
LAUNCH_MODE_FREE_ADS=false

# GENIUSPAY (Agrégateur de paiement Mobile Money & Cartes)
# Obtenez vos clés sur https://geniuspay.ci/dashboard/settings/api
GENIUSPAY_API_KEY=pk_sandbox_votre_cle_publique
GENIUSPAY_API_SECRET=sk_sandbox_votre_cle_secrete
GENIUSPAY_WEBHOOK_SECRET=whsec_sandbox_votre_secret_webhook
GENIUSPAY_ENVIRONMENT=sandbox # ou 'live'

# EMAIL TRANSACTIONNEL (SMTP)
# Sans configuration complète, les emails (ex: code OTP) sont simplement
# loggés en console en développement (NODE_ENV != production). En production,
# une configuration manquante fait échouer explicitement l'envoi plutôt que
# de rester silencieuse.
SMTP_HOST=mail.votre-domaine.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no_reply@votre-domaine.com
SMTP_PASSWORD=votre_mot_de_passe_smtp
EMAIL_FROM=no_reply@votre-domaine.com

# SESSION (authentification par cookie httpOnly signé)
# Générez une valeur aléatoire longue et gardez-la secrète, ex :
#   openssl rand -base64 48
SESSION_SECRET=remplacez_moi_par_une_valeur_aleatoire_longue_et_secrete

# CRON (protection de /api/cron/expirations)
# La route exige l'en-tête "Authorization: Bearer <CRON_SECRET>".
# Générez une valeur aléatoire longue (ex: openssl rand -base64 32) puis :
# - Vercel Cron Jobs : configurez le job dans vercel.json, Vercel ajoute
#   automatiquement cet en-tête pour les cron jobs internes au projet ; si
#   vous appelez la route depuis un service tiers, ajoutez l'en-tête vous-même.
# - Service externe (cron-job.org, EasyCron...) : configurez un en-tête HTTP
#   personnalisé "Authorization: Bearer <CRON_SECRET>" sur la requête planifiée.
CRON_SECRET=remplacez_moi_par_une_valeur_aleatoire_longue_et_secrete
